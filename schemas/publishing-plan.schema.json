{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publishing Plan",
  "type": "object",
  "required": ["project_name", "recommendations", "not_recommended", "required_confirmations"],
  "properties": {
    "project_name": {"type": "string"},
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "fit_score", "rationale", "content_angle"],
        "properties": {
          "platform": {"type": "string"},
          "fit_score": {"type": "integer", "minimum": 1, "maximum": 5},
          "rationale": {"type": "string"},
          "content_angle": {"type": "string"},
          "required_assets": {"type": "array", "items": {"type": "string"}},
          "risks": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "not_recommended": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "reason"],
        "properties": {
          "platform": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "required_confirmations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
